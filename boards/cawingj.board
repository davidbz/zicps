# Board file for MAME's `cawingj`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
cpu_clock = 10000000

program = 0x000000 0x020000 byte16 caj_36a.12f crc=0x91fceacd
program = 0x000001 0x020000 byte16 caj_42a.12h crc=0x039f8362
program = 0x040000 0x020000 byte16 caj_37a.13f crc=0xe5b75caf
program = 0x040001 0x020000 byte16 caj_43a.13h crc=0xc73fd713
program = 0x080000 0x020000 byte16 caj_34.10f crc=0x51ea57f4
program = 0x080001 0x020000 byte16 caj_40.10h crc=0x2ab71ae1
program = 0x0c0000 0x020000 byte16 caj_35.11f crc=0x01d71973
program = 0x0c0001 0x020000 byte16 caj_41.11h crc=0x3a43b538

gfx = 0x000000 0x020000 byte64 caj_09.4b crc=0x41b0f9a6
gfx = 0x000001 0x020000 byte64 caj_01.4a crc=0x1002d0b8
gfx = 0x000002 0x020000 byte64 caj_13.9b crc=0x6f3948b2
gfx = 0x000003 0x020000 byte64 caj_05.9a crc=0x207373d7
gfx = 0x000004 0x020000 byte64 caj_24.5e crc=0xe356aad7
gfx = 0x000005 0x020000 byte64 caj_17.5c crc=0x540f2fd8
gfx = 0x000006 0x020000 byte64 caj_38.8h crc=0x2464d4ab
gfx = 0x000007 0x020000 byte64 caj_32.8f crc=0x9b5836b3
gfx = 0x100000 0x020000 byte64 caj_10.5b crc=0xbf8a5f52
gfx = 0x100001 0x020000 byte64 caj_02.5a crc=0x125b018d
gfx = 0x100002 0x020000 byte64 caj_14.10b crc=0x8458e7d7
gfx = 0x100003 0x020000 byte64 caj_06.10a crc=0xcf80e164
gfx = 0x100004 0x020000 byte64 caj_25.7e crc=0xcdd0204d
gfx = 0x100005 0x020000 byte64 caj_18.7c crc=0x29c1d4b1
gfx = 0x100006 0x020000 byte64 caj_39.9h crc=0xeea23b67
gfx = 0x100007 0x020000 byte64 caj_33.9f crc=0xdde3891f

audio = 0x000000 0x008000 byte   caj_23.13b crc=0x96fe7485
audio = 0x010000 0x008000 byte   caj_23.13b 0x8000 crc=0x96fe7485

oki = 0x000000 0x020000 byte   caj_30.12c crc=0x4a613a2c
oki = 0x020000 0x020000 byte   caj_31.13c crc=0x74584493

# --- what the battery held -----------------------------------------------
layer_control   = 0x0c
priority        = 0x0a 0x08 0x06 0x04
palette_control = 0x02
layer_enable    = 0x10 0x0a 0x0a 0x00 0x00
id              = 0x00 0x0406

bank_sizes = 0x4000 0x4000 0x0 0x0
gfx_bank = sprites 0x00000 0x02fff 0
gfx_bank = scroll2 0x00000 0x02fff 0
gfx_bank = scroll3 0x03000 0x03fff 0
gfx_bank = scroll3 0x04000 0x04fff 1
gfx_bank = scroll1 0x05000 0x057ff 1
gfx_bank = sprites 0x05800 0x07fff 1
gfx_bank = scroll2 0x05800 0x07fff 1
