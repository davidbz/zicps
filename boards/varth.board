# Board file for MAME's `varth`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 vae_30b.11f crc=0xadb8d391
program = 0x000001 0x020000 byte16 vae_35b.11h crc=0x44e5548f
program = 0x040000 0x020000 byte16 vae_31b.12f crc=0x1749a71c
program = 0x040001 0x020000 byte16 vae_36b.12h crc=0x5f2e2450
program = 0x080000 0x020000 byte16 vae_28b.9f crc=0xe524ca50
program = 0x080001 0x020000 byte16 vae_33b.9h crc=0xc0bbf8c9
program = 0x0c0000 0x020000 byte16 vae_29b.10f crc=0x6640996a
program = 0x0c0001 0x020000 byte16 vae_34b.10h crc=0xfa59be8a

gfx = 0x000000 0x080000 word64 va-5m.7a crc=0xb1fb726e
gfx = 0x000002 0x080000 word64 va-7m.9a crc=0x4c6588cd
gfx = 0x000004 0x080000 word64 va-1m.3a crc=0x0b1ace37
gfx = 0x000006 0x080000 word64 va-3m.5a crc=0x44dfe706

audio = 0x000000 0x008000 byte   va_09.12b crc=0x7a99446e
audio = 0x010000 0x008000 byte   va_09.12b 0x8000 crc=0x7a99446e

oki = 0x000000 0x020000 byte   va_18.11c crc=0xde30510e
oki = 0x020000 0x020000 byte   va_19.12c crc=0x0610a4ac

# --- what the battery held -----------------------------------------------
layer_control   = 0x2e
priority        = 0x26 0x30 0x28 0x32
palette_control = 0x2a
layer_enable    = 0x02 0x04 0x08 0x00 0x00
id              = 0x20 0x0004

bank_sizes = 0x8000 0x0 0x0 0x0
gfx_bank = sprites|scroll1|scroll2|scroll3 0x00000 0x07fff 0
