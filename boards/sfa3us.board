# Board file for MAME's `sfa3us`, written by tools/mame_to_board.zig.
#
# Transcribed from MAME's CPS-2 driver (BSD-3-Clause, Paul Leaman and
# the MAME team): src/mame/capcom/cps2.cpp for the ROM map, and
# cps1_v.cpp for the one row every CPS-2 board shares.
# A CPS-2 board has no battery-backed configuration to hold: it is the
# CPS-B-21 at its default strapping, and what its battery holds is the
# decryption key: `key` below names the twenty bytes the set should
# carry, and `crypt` is what that battery held, from the last MAME to
# write the keys down (0.176, BSD-3-Clause, David Haywood).
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
system = cps2

program = 0x000000 0x080000 word   sz3-usam_03.6a crc=0x14319e29
program = 0x080000 0x080000 word   sz3-usam_04.7a crc=0x65fbc272
program = 0x100000 0x080000 word   sz3-usam_05.8a crc=0xe93c47d1
program = 0x180000 0x080000 word   sz3-usam_06.9a crc=0x1bf09de3
program = 0x200000 0x080000 word   sz3-usam_07.6d crc=0xf6296d96
program = 0x280000 0x080000 word   sz3-usam_08.7d crc=0x1f4008ff
program = 0x300000 0x080000 word   sz3-usam_09.8d crc=0x822fc451
program = 0x380000 0x080000 word   sz3-usam_10.9d crc=0x92713468

gfx = 0x000000 0x400000 word64 sz3.13m crc=0x0f7a60d9
gfx = 0x000002 0x400000 word64 sz3.15m crc=0x8e933741
gfx = 0x000004 0x400000 word64 sz3.17m crc=0xd6e98147
gfx = 0x000006 0x400000 word64 sz3.19m crc=0xf31a728a
gfx = 0x1000000 0x400000 word64 sz3.14m crc=0x5ff98297
gfx = 0x1000002 0x400000 word64 sz3.16m crc=0x52b5bdee
gfx = 0x1000004 0x400000 word64 sz3.18m crc=0x40631ed5
gfx = 0x1000006 0x400000 word64 sz3.20m crc=0x763409b4

audio = 0x000000 0x008000 byte   sz3-usam_01.1a crc=0xc180947d
audio = 0x010000 0x018000 byte   sz3-usam_01.1a 0x8000 crc=0xc180947d
audio = 0x028000 0x020000 byte   sz3-usam_02.2a crc=0x9ebc280f

qsound = 0x000000 0x400000 word   sz3.11m crc=0x1c89eed1
qsound = 0x400000 0x400000 word   sz3.12m crc=0xf392b13a

key = 0x000000 0x000014 byte   sfa3u.key crc=0x4a8f98c1

# --- what a CPS-2 board is strapped to -----------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x02 0x04 0x08 0x30 0x30
id              = 0x32 0xffff
multiply        = 0x00 0x02 0x04 0x06

bank_sizes = 0x20000 0x20000 0x0 0x0
gfx_bank = scroll1|scroll2|scroll3 0x00000 0x1ffff 1

crypt = 0xe7bbf0e5 0x67943248 0x000000 0x100000
