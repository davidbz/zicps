# Board file for MAME's `nemoj`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up (DESIGN.md §8.1),
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 nmj_36a.12f crc=0xdaeceabb
program = 0x000001 0x020000 byte16 nmj_42a.12h crc=0x55024740
program = 0x040000 0x020000 byte16 nmj_37a.13f crc=0x619068b6
program = 0x040001 0x020000 byte16 nmj_43a.13h crc=0xa948a53b
program = 0x080000 0x020000 byte16 nmj_34.10f crc=0x5737feed
program = 0x080001 0x020000 byte16 nmj_40.10h crc=0x8a4099f3
program = 0x0c0000 0x020000 byte16 nmj_35.11f crc=0xbd11a7f8
program = 0x0c0001 0x020000 byte16 nmj_41.11h crc=0x6309603d

gfx = 0x000000 0x020000 byte64 nmj_09.4b crc=0x9d60d286
gfx = 0x000001 0x020000 byte64 nmj_01.4a crc=0x8a83f7c4
gfx = 0x000002 0x020000 byte64 nmj_13.9b crc=0xa4909fe0
gfx = 0x000003 0x020000 byte64 nmj_05.9a crc=0x16db1e61
gfx = 0x000004 0x020000 byte64 nmj_24.5e crc=0x3312c648
gfx = 0x000005 0x020000 byte64 nmj_17.5c crc=0xccfc50e2
gfx = 0x000006 0x020000 byte64 nmj_38.8h crc=0xae98a997
gfx = 0x000007 0x020000 byte64 nmj_32.8f crc=0xb3704dde
gfx = 0x100000 0x020000 byte64 nmj_10.5b crc=0x33c1388c
gfx = 0x100001 0x020000 byte64 nmj_02.5a crc=0x84c69469
gfx = 0x100002 0x020000 byte64 nmj_14.10b crc=0x66612270
gfx = 0x100003 0x020000 byte64 nmj_06.10a crc=0x8b9bcf95
gfx = 0x100004 0x020000 byte64 nmj_25.7e crc=0xacfc84d2
gfx = 0x100005 0x020000 byte64 nmj_18.7c crc=0x4347deed
gfx = 0x100006 0x020000 byte64 nmj_39.9h crc=0x6a274ecd
gfx = 0x100007 0x020000 byte64 nmj_33.9f crc=0xc469dc74

# --- what the battery held -----------------------------------------------
layer_control   = 0x02
priority        = 0x04 0x06 0x08 0x0a
palette_control = 0x0c
layer_enable    = 0x04 0x02 0x20 0x00 0x00
id              = 0x0e 0x0405

bank_sizes = 0x8000 0x0 0x0 0x0
gfx_bank = sprites 0x00000 0x03fff 0
gfx_bank = scroll2 0x00000 0x03fff 0
gfx_bank = scroll1 0x04000 0x047ff 0
gfx_bank = sprites 0x04800 0x067ff 0
gfx_bank = scroll2 0x04800 0x067ff 0
gfx_bank = scroll3 0x06800 0x07fff 0
