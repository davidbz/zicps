# Board file for MAME's `mvsca`, written by tools/mame_to_board.zig.
#
# Transcribed from MAME's CPS-2 driver (BSD-3-Clause, Paul Leaman and
# the MAME team): src/mame/capcom/cps2.cpp for the ROM map, and
# cps1_v.cpp for the one row every CPS-2 board shares.
# A CPS-2 board has no battery-backed configuration to hold: it is the
# CPS-B-21 at its default strapping, and what its battery holds is the
# decryption key: `key` below names the twenty bytes the set should
# carry, and `crypt` is what that battery held, from the last MAME to
# write the keys down (0.176, BSD-3-Clause, David Haywood).
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
system = cps2

program = 0x000000 0x080000 word   mvca.03a crc=0x2ff4ae25
program = 0x080000 0x080000 word   mvca.04a crc=0xf28427ef
program = 0x100000 0x080000 word   mvc.05a crc=0x2d8c8e86
program = 0x180000 0x080000 word   mvc.06a crc=0x8528e1f5
program = 0x200000 0x080000 word   mvc.07 crc=0xc3baa32b
program = 0x280000 0x080000 word   mvc.08 crc=0xbc002fcd
program = 0x300000 0x080000 word   mvc.09 crc=0xc67b26df
program = 0x380000 0x080000 word   mvc.10 crc=0x0fdd1e26

gfx = 0x000000 0x400000 word64 mvc.13m crc=0xfa5f74bc
gfx = 0x000002 0x400000 word64 mvc.15m crc=0x71938a8f
gfx = 0x000004 0x400000 word64 mvc.17m crc=0x92741d07
gfx = 0x000006 0x400000 word64 mvc.19m crc=0xbcb72fc6
gfx = 0x1000000 0x400000 word64 mvc.14m crc=0x7f1df4e4
gfx = 0x1000002 0x400000 word64 mvc.16m crc=0x90bd3203
gfx = 0x1000004 0x400000 word64 mvc.18m crc=0x67aaf727
gfx = 0x1000006 0x400000 word64 mvc.20m crc=0x8b0bade8

audio = 0x000000 0x008000 byte   mvc.01 crc=0x41629e95
audio = 0x010000 0x018000 byte   mvc.01 0x8000 crc=0x41629e95
audio = 0x028000 0x020000 byte   mvc.02 crc=0x963abf6b

qsound = 0x000000 0x400000 word   mvc.11m crc=0x850fe663
qsound = 0x400000 0x400000 word   mvc.12m crc=0x7ccb1896

key = 0x000000 0x000014 byte   mvsca.key crc=0x31edaee8

# --- what a CPS-2 board is strapped to -----------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x02 0x04 0x08 0x30 0x30
id              = 0x32 0xffff
multiply        = 0x00 0x02 0x04 0x06

bank_sizes = 0x20000 0x20000 0x0 0x0
gfx_bank = scroll1|scroll2|scroll3 0x00000 0x1ffff 1

crypt = 0xf248aec6 0x7905cd17 0x000000 0x100000
