# Board file for MAME's `cawingr1`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up (DESIGN.md §8.1),
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 cae_30.11f crc=0x23305cd5
program = 0x000001 0x020000 byte16 cae_35.11h crc=0x69419113
program = 0x040000 0x020000 byte16 cae_31.12f crc=0x9008dfb3
program = 0x040001 0x020000 byte16 cae_36.12h crc=0x4dbf6f8e
program = 0x080000 0x080000 word   ca-32m.8h crc=0x0c4837d4

gfx = 0x000000 0x080000 word64 ca-5m.7a crc=0x66d4cc37
gfx = 0x000002 0x080000 word64 ca-7m.9a crc=0xb6f896f2
gfx = 0x000004 0x080000 word64 ca-1m.3a crc=0x4d0620fd
gfx = 0x000006 0x080000 word64 ca-3m.5a crc=0x0b0341c3

# --- what the battery held -----------------------------------------------
layer_control   = 0x0c
priority        = 0x0a 0x08 0x06 0x04
palette_control = 0x02
layer_enable    = 0x10 0x0a 0x0a 0x00 0x00
id              = 0x00 0x0406

bank_sizes = 0x8000 0x0 0x0 0x0
gfx_bank = sprites 0x00000 0x02fff 0
gfx_bank = scroll2 0x00000 0x02fff 0
gfx_bank = scroll3 0x03000 0x04fff 0
gfx_bank = scroll1 0x05000 0x057ff 0
gfx_bank = sprites 0x05800 0x07fff 0
gfx_bank = scroll2 0x05800 0x07fff 0
