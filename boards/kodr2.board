# Board file for MAME's `kodr2`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 kde_30.11e crc=0xf8dc4ce3
program = 0x000001 0x020000 byte16 kde_37.11f crc=0xd1276c1c
program = 0x040000 0x020000 byte16 kde_31.12e crc=0x309debd8
program = 0x040001 0x020000 byte16 kde_38.12f crc=0x76cd5738
program = 0x080000 0x020000 byte16 kd_28.9e crc=0x9367bcd9
program = 0x080001 0x020000 byte16 kd_35.9f crc=0x4ca6a48a
program = 0x0c0000 0x020000 byte16 kd_29.10e crc=0x0360fa72
program = 0x0c0001 0x020000 byte16 kd_36.10f crc=0x3c66c32b

gfx = 0x000000 0x080000 word64 kd-5m.4a crc=0xe45b8701
gfx = 0x000002 0x080000 word64 kd-7m.6a crc=0xa7750322
gfx = 0x000004 0x080000 word64 kd-1m.3a crc=0x5f74bf78
gfx = 0x000006 0x080000 word64 kd-3m.5a crc=0x5e5303bf
gfx = 0x200000 0x080000 word64 kd-6m.4c crc=0x113358f3
gfx = 0x200002 0x080000 word64 kd-8m.6c crc=0x38853c44
gfx = 0x200004 0x080000 word64 kd-2m.3c crc=0x9ef36604
gfx = 0x200006 0x080000 word64 kd-4m.5c crc=0x402b9b4f

audio = 0x000000 0x008000 byte   kd_9.12a crc=0xbac6ec26
audio = 0x010000 0x008000 byte   kd_9.12a 0x8000 crc=0xbac6ec26

oki = 0x000000 0x020000 byte   kd_18.11c crc=0x4c63181d
oki = 0x020000 0x020000 byte   kd_19.12c crc=0x92941b80

# --- what the battery held -----------------------------------------------
layer_control   = 0x20
priority        = 0x2e 0x2c 0x2a 0x28
palette_control = 0x30
layer_enable    = 0x30 0x08 0x30 0x00 0x00
multiply        = 0x1e 0x1c 0x1a 0x18
in2             = 0x36
out2            = 0x34

bank_sizes = 0x8000 0x8000 0x0 0x0
gfx_bank = sprites 0x00000 0x07fff 0
gfx_bank = sprites 0x08000 0x08fff 1
gfx_bank = scroll2 0x09000 0x0bfff 1
gfx_bank = scroll1 0x0c000 0x0d7ff 1
gfx_bank = scroll3 0x0d800 0x0ffff 1
