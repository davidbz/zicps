gfx = 0x000006 0x040000 byte64 22.e5 crc=0x4109d637
gfx = 0x000007 0x040000 byte64 12.c5 crc=0x5d21d8b3
gfx = 0x200000 0x040000 byte64 25.e8 crc=0x72e923df
gfx = 0x200001 0x040000 byte64 15.c8 crc=0x9a96be48
gfx = 0x200002 0x040000 byte64 27.e10 crc=0x4a3a8d09
gfx = 0x200003 0x040000 byte64 17.c10 crc=0xa917a922
gfx = 0x200004 0x040000 byte64 21.e4 crc=0x55c2b455
gfx = 0x200005 0x040000 byte64 11.c4 crc=0xff36859e
gfx = 0x200006 0x040000 byte64 23.e6 crc=0xef9c2d4d
gfx = 0x200007 0x040000 byte64 13.c6 crc=0xbc937c96
gfx = 0x400000 0x040000 byte64 6.a8 crc=0x023baa18
gfx = 0x400001 0x040000 byte64 5.a7 crc=0xa6ad6ef3
gfx = 0x400002 0x040000 byte64 8.a10 crc=0x26fb340c
