# Board file for MAME's `sf2ceblp`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up (DESIGN.md §8.1),
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 1k.31.e13 crc=0xea78f9b4
program = 0x000001 0x020000 byte16 se.36.j13 crc=0xd30c263e
program = 0x040000 0x020000 byte16 0e.30.e11 crc=0x005b54cc
program = 0x040001 0x020000 byte16 de.35.j11 crc=0xc184d26d
program = 0x080000 0x020000 byte16 bk.29.e10 crc=0x524f5c55
program = 0x080001 0x020000 byte16 ff.34.j10 crc=0xf06a12f2
program = 0x0c0000 0x040000 byte16 8k.28.e9 crc=0xb7ad5214
program = 0x0c0001 0x040000 byte16 tf.33.j9 crc=0x6340b914

gfx = 0x000000 0x040000 byte64 24.e7 crc=0xa8b5633a
gfx = 0x000001 0x040000 byte64 14.c7 crc=0x5db24ca7
gfx = 0x000002 0x040000 byte64 26.e9 crc=0x82e8e384
gfx = 0x000003 0x040000 byte64 16.c9 crc=0x1fd98ad0
