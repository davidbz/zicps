# Board file for MAME's `1941r1`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up (DESIGN.md §8.1),
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 41e_30.11f crc=0x9deb1e75
program = 0x000001 0x020000 byte16 41e_35.11h crc=0xd63942b3
program = 0x040000 0x020000 byte16 41e_31.12f crc=0xdf201112
program = 0x040001 0x020000 byte16 41e_36.12h crc=0x816a818f
program = 0x080000 0x080000 word   41-32m.8h crc=0x4e9648ca

gfx = 0x000000 0x080000 word64 41-5m.7a crc=0x01d1cb11
gfx = 0x000002 0x080000 word64 41-7m.9a crc=0xaeaa3509
gfx = 0x000004 0x080000 word64 41-1m.3a crc=0xff77985a
gfx = 0x000006 0x080000 word64 41-3m.5a crc=0x983be58f

# --- what the battery held -----------------------------------------------
layer_control   = 0x28
priority        = 0x2a 0x2c 0x2e 0x30
palette_control = 0x32
layer_enable    = 0x02 0x08 0x20 0x14 0x14
id              = 0x20 0x0005

bank_sizes = 0x8000 0x0 0x0 0x0
gfx_bank = sprites 0x00000 0x01fff 0
gfx_bank = scroll3 0x02000 0x03fff 0
gfx_bank = scroll1 0x04000 0x047ff 0
gfx_bank = scroll2 0x04800 0x07fff 0
