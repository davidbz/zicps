# Board file for MAME's `slammastu`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x080000 word   mbu_23e.8f crc=0x224f0062
program = 0x080000 0x020000 byte16 mbu_24b.9e crc=0x95d5e729
program = 0x080001 0x020000 byte16 mbu_28b.9f crc=0xb1c7cbcb
program = 0x0c0000 0x020000 byte16 mbu_25b.10e crc=0xa50d3fd4
program = 0x0c0001 0x020000 byte16 mbu_29b.10f crc=0x08e32e56
program = 0x100000 0x080000 word   mbu_21a.6f crc=0xd5007b05
program = 0x180000 0x080000 word   mbu_20a.5f crc=0xfc848af5

gfx = 0x000000 0x080000 word64 mb-1m.3a crc=0x41468e06
gfx = 0x000002 0x080000 word64 mb-3m.5a crc=0xf453aa9e
gfx = 0x000004 0x080000 word64 mb-2m.4a crc=0x2ffbfea8
gfx = 0x000006 0x080000 word64 mb-4m.6a crc=0x1eb9841d
gfx = 0x200000 0x080000 word64 mb-5m.7a crc=0x506b9dc9
gfx = 0x200002 0x080000 word64 mb-7m.9a crc=0xaff8c2fb
gfx = 0x200004 0x080000 word64 mb-6m.8a crc=0xb76c70e9
gfx = 0x200006 0x080000 word64 mb-8m.10a crc=0xe60c9556
gfx = 0x400000 0x080000 word64 mb-10m.3c crc=0x97976ff5
gfx = 0x400002 0x080000 word64 mb-12m.5c crc=0xb350a840
gfx = 0x400004 0x080000 word64 mb-11m.4c crc=0x8fb94743
gfx = 0x400006 0x080000 word64 mb-13m.6c crc=0xda810d5f

audio = 0x000000 0x008000 byte   mb_qa.5k crc=0xe21a03c4
audio = 0x010000 0x018000 byte   mb_qa.5k 0x8000 crc=0xe21a03c4

qsound = 0x000000 0x080000 byte   mb-q1.1k crc=0x0630c3ce
qsound = 0x080000 0x080000 byte   mb-q2.2k crc=0x354f9c21
qsound = 0x100000 0x080000 byte   mb-q3.3k crc=0x7838487c
qsound = 0x180000 0x080000 byte   mb-q4.4k crc=0xab66e087
qsound = 0x200000 0x080000 byte   mb-q5.1m crc=0xc789fef2
qsound = 0x280000 0x080000 byte   mb-q6.2m crc=0xecb81b61
qsound = 0x300000 0x080000 byte   mb-q7.3m crc=0x041e49ba
qsound = 0x380000 0x080000 byte   mb-q8.4m crc=0x59fe702a

# --- what the battery held -----------------------------------------------
layer_control   = 0x16
priority        = 0x00 0x02 0x28 0x2a
palette_control = 0x2c
layer_enable    = 0x04 0x08 0x10 0x00 0x00
id              = 0x2e 0x0c01

bank_sizes = 0x8000 0x8000 0x8000 0x0
gfx_bank = sprites|scroll1|scroll2|scroll3 0x00000 0x07fff 0
gfx_bank = sprites|scroll1|scroll2|scroll3 0x08000 0x0ffff 1
gfx_bank = sprites|scroll1|scroll2|scroll3 0x10000 0x17fff 2

kabuki = 0x54321076 0x65432107 0x3131 0x19
