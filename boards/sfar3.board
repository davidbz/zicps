# Board file for MAME's `sfar3`, written by tools/mame_to_board.zig.
#
# Transcribed from MAME's CPS-2 driver (BSD-3-Clause, Paul Leaman and
# the MAME team): src/mame/capcom/cps2.cpp for the ROM map, and
# cps1_v.cpp for the one row every CPS-2 board shares.
# A CPS-2 board has no battery-backed configuration to hold: it is the
# CPS-B-21 at its default strapping, and what its battery holds is the
# decryption key, which is `key` below.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
system = cps2

program = 0x000000 0x080000 word   sfze.03a crc=0xfdbcd434
program = 0x080000 0x080000 word   sfz.04 crc=0x0c436d30
program = 0x100000 0x080000 word   sfz.05 crc=0x1f363612
program = 0x180000 0x080000 word   sfz.06 crc=0x806e8f38

gfx = 0x800000 0x200000 word64 sfz.14m crc=0x90fefdb3
gfx = 0x800002 0x200000 word64 sfz.16m crc=0x5354c948
gfx = 0x800004 0x200000 word64 sfz.18m crc=0x41a1e790
gfx = 0x800006 0x200000 word64 sfz.20m crc=0xa549df98

audio = 0x000000 0x008000 byte   sfz.01 crc=0xffffec7d
audio = 0x010000 0x018000 byte   sfz.01 0x8000 crc=0xffffec7d
audio = 0x028000 0x020000 byte   sfz.02 crc=0x45f46a08

qsound = 0x000000 0x200000 word   sfz.11m crc=0xc4b093cd
qsound = 0x200000 0x200000 word   sfz.12m crc=0x8bdbc4b4

key = 0x000000 0x000014 byte   sfa.key crc=0x7c095631

# --- what a CPS-2 board is strapped to -----------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x02 0x04 0x08 0x30 0x30
id              = 0x32 0xffff
multiply        = 0x00 0x02 0x04 0x06

bank_sizes = 0x20000 0x20000 0x0 0x0
gfx_bank = scroll1|scroll2|scroll3 0x00000 0x1ffff 1
