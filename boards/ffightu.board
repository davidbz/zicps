# Board file for MAME's `ffightu`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up (DESIGN.md §8.1),
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 ff_36.11f crc=0xf9a5ce83
program = 0x000001 0x020000 byte16 ff_42.11h crc=0x65f11215
program = 0x040000 0x020000 byte16 ff_37.12f crc=0xe1033784
program = 0x040001 0x020000 byte16 ffu_43.12h crc=0x4ca65947
program = 0x080000 0x080000 word   ff-32m.8h crc=0xc747696e

gfx = 0x000000 0x080000 word64 ff-5m.7a crc=0x9c284108
gfx = 0x000002 0x080000 word64 ff-7m.9a crc=0xa7584dfb
gfx = 0x000004 0x080000 word64 ff-1m.3a crc=0x0b605e44
gfx = 0x000006 0x080000 word64 ff-3m.5a crc=0x52291cd2

# --- what the battery held -----------------------------------------------
layer_control   = 0x2e
priority        = 0x26 0x30 0x28 0x32
palette_control = 0x2a
layer_enable    = 0x02 0x04 0x08 0x00 0x00
id              = 0x20 0x0004

bank_sizes = 0x8000 0x0 0x0 0x0
gfx_bank = sprites 0x00000 0x043ff 0
gfx_bank = scroll1 0x04400 0x04bff 0
gfx_bank = scroll3 0x04c00 0x05fff 0
gfx_bank = scroll2 0x06000 0x07fff 0
