# Board file for MAME's `area88`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 ar_36.12f crc=0x65030392
program = 0x000001 0x020000 byte16 ar_42.12h crc=0xc48170de
program = 0x040000 0x020000 byte16 ar_37.13f crc=0x33e9694b
program = 0x040001 0x020000 byte16 ar_43.13h crc=0x7cc8fb9e
program = 0x080000 0x020000 byte16 ar_34.10f crc=0xf6e80386
program = 0x080001 0x020000 byte16 ar_40.10h crc=0xbe36c145
program = 0x0c0000 0x020000 byte16 ar_35.11f crc=0x86d98ff3
program = 0x0c0001 0x020000 byte16 ar_41.11h crc=0x758893d3

gfx = 0x000000 0x020000 byte64 ar_09.4b crc=0xdb9376f8
gfx = 0x000001 0x020000 byte64 ar_01.4a crc=0x392151b4
gfx = 0x000002 0x020000 byte64 ar_13.9b crc=0x81436481
gfx = 0x000003 0x020000 byte64 ar_05.9a crc=0xe246ed9f
gfx = 0x000004 0x020000 byte64 ar_24.5e crc=0x9cd6e2a3
gfx = 0x000005 0x020000 byte64 ar_17.5c crc=0x0b8e0df4
gfx = 0x000006 0x020000 byte64 ar_38.8h crc=0x8b9e75b9
gfx = 0x000007 0x020000 byte64 ar_32.8f crc=0xdb6acdcf
gfx = 0x100000 0x020000 byte64 ar_10.5b crc=0x4219b622
gfx = 0x100001 0x020000 byte64 ar_02.5a crc=0xbac5dec5
gfx = 0x100002 0x020000 byte64 ar_14.10b crc=0xe6bae179
gfx = 0x100003 0x020000 byte64 ar_06.10a crc=0xc8f04223
gfx = 0x100004 0x020000 byte64 ar_25.7e crc=0x15ccf981
gfx = 0x100005 0x020000 byte64 ar_18.7c crc=0x9336db6a
gfx = 0x100006 0x020000 byte64 ar_39.9h crc=0x9b8e1363
gfx = 0x100007 0x020000 byte64 ar_33.9f crc=0x3968f4b5

audio = 0x000000 0x008000 byte   ar_23.13c crc=0xf3dd1367
audio = 0x010000 0x008000 byte   ar_23.13c 0x8000 crc=0xf3dd1367

oki = 0x000000 0x020000 byte   ar_30.12e crc=0x584b43a9

# --- what the battery held -----------------------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x08 0x10 0x20 0x00 0x00
id              = 0x32 0x0401

bank_sizes = 0x4000 0x4000 0x0 0x0
gfx_bank = sprites 0x00000 0x02fff 0
gfx_bank = scroll1 0x03000 0x03fff 0
gfx_bank = scroll2 0x04000 0x05fff 1
gfx_bank = scroll3 0x06000 0x07fff 1
