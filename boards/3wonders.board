# Board file for MAME's `3wonders`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
cpu_clock = 10000000

program = 0x000000 0x020000 byte16 rte_30a.11f crc=0xef5b8b33
program = 0x000001 0x020000 byte16 rte_35a.11h crc=0x7d705529
program = 0x040000 0x020000 byte16 rte_31a.12f crc=0x32835e5e
program = 0x040001 0x020000 byte16 rte_36a.12h crc=0x7637975f
program = 0x080000 0x020000 byte16 rt_28a.9f crc=0x054137c8
program = 0x080001 0x020000 byte16 rt_33a.9h crc=0x7264cb1b
program = 0x0c0000 0x020000 byte16 rte_29a.10f crc=0xcddaa919
program = 0x0c0001 0x020000 byte16 rte_34a.10h crc=0xed52e7e5

gfx = 0x000000 0x080000 word64 rt-5m.7a crc=0x86aef804
gfx = 0x000002 0x080000 word64 rt-7m.9a crc=0x4f057110
gfx = 0x000004 0x080000 word64 rt-1m.3a crc=0x902489d0
gfx = 0x000006 0x080000 word64 rt-3m.5a crc=0xe35ce720
gfx = 0x200000 0x080000 word64 rt-6m.8a crc=0x13cb0e7c
gfx = 0x200002 0x080000 word64 rt-8m.10a crc=0x1f055014
gfx = 0x200004 0x080000 word64 rt-2m.4a crc=0xe9a034f4
gfx = 0x200006 0x080000 word64 rt-4m.6a crc=0xdf0eea8b

audio = 0x000000 0x008000 byte   rt_9.12b crc=0xabfca165
audio = 0x010000 0x008000 byte   rt_9.12b 0x8000 crc=0xabfca165

oki = 0x000000 0x020000 byte   rt_18.11c crc=0x26b211ab
oki = 0x020000 0x020000 byte   rt_19.12c crc=0xdbe64ad0

# --- what the battery held -----------------------------------------------
layer_control   = 0x28
priority        = 0x26 0x24 0x22 0x20
palette_control = 0x30
layer_enable    = 0x20 0x04 0x08 0x12 0x12
id              = 0x32 0x0800
multiply        = 0x0e 0x0c 0x0a 0x08

bank_sizes = 0x8000 0x8000 0x0 0x0
gfx_bank = sprites 0x00000 0x053ff 0
gfx_bank = scroll1 0x05400 0x06fff 0
gfx_bank = scroll3 0x07000 0x07fff 0
gfx_bank = scroll3 0x00000 0x03fff 1
gfx_bank = scroll2 0x02800 0x07fff 1
gfx_bank = sprites 0x05400 0x07fff 1
