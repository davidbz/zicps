# Board file for MAME's `captcommr1`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x080000 word   cce_23d.8f crc=0x19c58ece
program = 0x080000 0x080000 word   cc_22d.7f crc=0xa91949b7
program = 0x100000 0x020000 byte16 cc_24d.9e crc=0x680e543f
program = 0x100001 0x020000 byte16 cc_28d.9f crc=0x8820039f

gfx = 0x000000 0x080000 word64 cc-5m.3a crc=0x7261d8ba
gfx = 0x000002 0x080000 word64 cc-7m.5a crc=0x6a60f949
gfx = 0x000004 0x080000 word64 cc-1m.4a crc=0x00637302
gfx = 0x000006 0x080000 word64 cc-3m.6a crc=0xcc87cf61
gfx = 0x200000 0x080000 word64 cc-6m.7a crc=0x28718bed
gfx = 0x200002 0x080000 word64 cc-8m.9a crc=0xd4acc53a
gfx = 0x200004 0x080000 word64 cc-2m.8a crc=0x0c69f151
gfx = 0x200006 0x080000 word64 cc-4m.10a crc=0x1f9ebb97

audio = 0x000000 0x008000 byte   cc_09.11a crc=0x698e8b58
audio = 0x010000 0x008000 byte   cc_09.11a 0x8000 crc=0x698e8b58

oki = 0x000000 0x020000 byte   cc_18.11c crc=0x6de2c2db
oki = 0x020000 0x020000 byte   cc_19.12c crc=0xb99091ae

# --- what the battery held -----------------------------------------------
layer_control   = 0x20
priority        = 0x2e 0x2c 0x2a 0x28
palette_control = 0x30
layer_enable    = 0x20 0x12 0x12 0x00 0x00
multiply        = 0x06 0x04 0x02 0x00
in2             = 0x36
in3             = 0x38
out2            = 0x34

bank_sizes = 0x8000 0x8000 0x0 0x0
gfx_bank = sprites 0x00000 0x07fff 0
gfx_bank = scroll2 0x00000 0x07fff 0
gfx_bank = sprites 0x08000 0x0ffff 1
gfx_bank = scroll1 0x08000 0x0ffff 1
gfx_bank = scroll2 0x08000 0x0ffff 1
gfx_bank = scroll3 0x08000 0x0ffff 1
