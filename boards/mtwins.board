# Board file for MAME's `mtwins`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
cpu_clock = 10000000

program = 0x000000 0x020000 byte16 che_30.11f crc=0x9a2a2db1
program = 0x000001 0x020000 byte16 che_35.11h crc=0xa7f96b02
program = 0x040000 0x020000 byte16 che_31.12f crc=0xbbff8a99
program = 0x040001 0x020000 byte16 che_36.12h crc=0x0fa00c39
program = 0x080000 0x080000 word   ck-32m.8h crc=0x9b70bd41

gfx = 0x000000 0x080000 word64 ck-5m.7a crc=0x4ec75f15
gfx = 0x000002 0x080000 word64 ck-7m.9a crc=0xd85d00d6
gfx = 0x000004 0x080000 word64 ck-1m.3a crc=0xf33ca9d4
gfx = 0x000006 0x080000 word64 ck-3m.5a crc=0x0ba2047f

audio = 0x000000 0x008000 byte   ch_09.12b crc=0x4d4255b7
audio = 0x010000 0x008000 byte   ch_09.12b 0x8000 crc=0x4d4255b7

oki = 0x000000 0x020000 byte   ch_18.11c crc=0xf909e8de
oki = 0x020000 0x020000 byte   ch_19.12c crc=0xfc158cf7

# --- what the battery held -----------------------------------------------
layer_control   = 0x12
priority        = 0x14 0x16 0x18 0x1a
palette_control = 0x1c
layer_enable    = 0x08 0x20 0x10 0x00 0x00
id              = 0x1e 0x0404

bank_sizes = 0x8000 0x0 0x0 0x0
gfx_bank = sprites 0x00000 0x02fff 0
gfx_bank = scroll1 0x03000 0x03fff 0
gfx_bank = scroll2 0x04000 0x06fff 0
gfx_bank = scroll3 0x07000 0x07fff 0
