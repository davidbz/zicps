# Board file for MAME's `sf2qp2`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up (DESIGN.md §8.1),
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x040000 word   qkn.33 crc=0x43aa343d
program = 0x0c0000 0x040000 word   qkn.33 0x40000 crc=0x43aa343d
program = 0x080000 0x040000 word   qkn.34 crc=0xd03b553f
program = 0x040000 0x040000 word   qkn.34 0x40000 crc=0xd03b553f

gfx = 0x000000 0x080000 word64 sf2_06.bin crc=0x22c9cc8e
gfx = 0x000002 0x080000 word64 sf2_08.bin crc=0x57213be8
gfx = 0x000004 0x080000 word64 sf2_05.bin crc=0xba529b4f
gfx = 0x000006 0x080000 word64 sf2_07.bin crc=0x4b1b33a8
gfx = 0x200000 0x080000 word64 sf2_15.bin crc=0x2c7e2229
gfx = 0x200002 0x080000 word64 sf2_17.bin crc=0xb5548f17
gfx = 0x200004 0x080000 word64 sf2_14.bin crc=0x14b84312
gfx = 0x200006 0x080000 word64 sf2_16.bin crc=0x5e9cd89a
gfx = 0x400000 0x080000 word64 sf2_25.bin crc=0x994bfa58
gfx = 0x400002 0x080000 word64 sf2_27.bin crc=0x3e66ad9d
gfx = 0x400004 0x080000 word64 sf2_24.bin crc=0xc1befaa8
gfx = 0x400006 0x080000 word64 sf2_26.bin crc=0x0627c831

# --- what the battery held -----------------------------------------------
layer_control   = 0x12
priority        = 0x14 0x16 0x18 0x1a
palette_control = 0x1c
layer_enable    = 0x08 0x20 0x10 0x00 0x00
id              = 0x1e 0x0404
in2             = 0x36

bank_sizes = 0x8000 0x8000 0x8000 0x0
gfx_bank = sprites 0x00000 0x07fff 0
gfx_bank = sprites 0x08000 0x0ffff 1
gfx_bank = sprites 0x10000 0x11fff 2
gfx_bank = scroll3 0x02000 0x03fff 2
gfx_bank = scroll1 0x04000 0x04fff 2
gfx_bank = scroll2 0x05000 0x07fff 2
