# Board file for MAME's `vsavj`, written by tools/mame_to_board.zig.
#
# Transcribed from MAME's CPS-2 driver (BSD-3-Clause, Paul Leaman and
# the MAME team): src/mame/capcom/cps2.cpp for the ROM map, and
# cps1_v.cpp for the one row every CPS-2 board shares.
# A CPS-2 board has no battery-backed configuration to hold: it is the
# CPS-B-21 at its default strapping, and what its battery holds is the
# decryption key: `key` below names the twenty bytes the set should
# carry, and `crypt` is what that battery held, from the last MAME to
# write the keys down (0.176, BSD-3-Clause, David Haywood).
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
system = cps2

program = 0x000000 0x080000 word   vm3j.03d crc=0x2a2e74a4
program = 0x080000 0x080000 word   vm3j.04d crc=0x1c2427bc
program = 0x100000 0x080000 word   vm3j.05a crc=0x95ce88d5
program = 0x180000 0x080000 word   vm3j.06b crc=0x2c4297e0
program = 0x200000 0x080000 word   vm3j.07b crc=0xa38aaae7
program = 0x280000 0x080000 word   vm3j.08a crc=0x5773e5c9
program = 0x300000 0x080000 word   vm3j.09b crc=0xd064f8b9
program = 0x380000 0x080000 word   vm3j.10b crc=0x434518e9

gfx = 0x000000 0x400000 word64 vm3.13m crc=0xfd8a11eb
gfx = 0x000002 0x400000 word64 vm3.15m crc=0xdd1e7d4e
gfx = 0x000004 0x400000 word64 vm3.17m crc=0x6b89445e
gfx = 0x000006 0x400000 word64 vm3.19m crc=0x3830fdc7
gfx = 0x1000000 0x400000 word64 vm3.14m crc=0xc1a28e6c
gfx = 0x1000002 0x400000 word64 vm3.16m crc=0x194a7304
gfx = 0x1000004 0x400000 word64 vm3.18m crc=0xdf9a9f47
gfx = 0x1000006 0x400000 word64 vm3.20m crc=0xc22fc3d9

audio = 0x000000 0x008000 byte   vm3.01 crc=0xf778769b
audio = 0x010000 0x018000 byte   vm3.01 0x8000 crc=0xf778769b
audio = 0x028000 0x020000 byte   vm3.02 crc=0xcc09faa1

qsound = 0x000000 0x400000 word   vm3.11m crc=0xe80e956e
qsound = 0x400000 0x400000 word   vm3.12m crc=0x9cd71557

key = 0x000000 0x000014 byte   vsavj.key crc=0x36d28ab8

# --- what a CPS-2 board is strapped to -----------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x02 0x04 0x08 0x30 0x30
id              = 0x32 0xffff
multiply        = 0x00 0x02 0x04 0x06

bank_sizes = 0x20000 0x20000 0x0 0x0
gfx_bank = scroll1|scroll2|scroll3 0x00000 0x1ffff 1

crypt = 0xfa8f4e33 0xa4b881b9 0x000000 0x100000
