# Board file for MAME's `qndream`, written by tools/mame_to_board.zig.
#
# Transcribed from MAME's CPS-2 driver (BSD-3-Clause, Paul Leaman and
# the MAME team): src/mame/capcom/cps2.cpp for the ROM map, and
# cps1_v.cpp for the one row every CPS-2 board shares.
# A CPS-2 board has no battery-backed configuration to hold: it is the
# CPS-B-21 at its default strapping, and what its battery holds is the
# decryption key, which is `key` below.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
system = cps2

program = 0x000000 0x080000 word   tqzj.03a crc=0x7acf3e30
program = 0x080000 0x080000 word   tqzj.04 crc=0xf1044a87
program = 0x100000 0x080000 word   tqzj.05 crc=0x4105ba0e
program = 0x180000 0x080000 word   tqzj.06 crc=0xc371e8a5

gfx = 0x800000 0x200000 word64 tqz.14m crc=0x98af88a2
gfx = 0x800002 0x200000 word64 tqz.16m crc=0xdf82d491
gfx = 0x800004 0x200000 word64 tqz.18m crc=0x42f132ff
gfx = 0x800006 0x200000 word64 tqz.20m crc=0xb2e128a3

audio = 0x000000 0x008000 byte   tqz.01 crc=0xe9ce9d0a
audio = 0x010000 0x018000 byte   tqz.01 0x8000 crc=0xe9ce9d0a

qsound = 0x000000 0x200000 word   tqz.11m crc=0x78e7884f
qsound = 0x200000 0x200000 word   tqz.12m crc=0x2e049b13

key = 0x000000 0x000014 byte   qndream.key crc=0x97eee4ff

# --- what a CPS-2 board is strapped to -----------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x02 0x04 0x08 0x30 0x30
id              = 0x32 0xffff
multiply        = 0x00 0x02 0x04 0x06

bank_sizes = 0x20000 0x20000 0x0 0x0
gfx_bank = scroll1|scroll2|scroll3 0x00000 0x1ffff 1
