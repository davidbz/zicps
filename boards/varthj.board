program = 0x080001 0x020000 byte16 vaj_40b.10h crc=0x210b4bd0
program = 0x0c0000 0x020000 byte16 vaj_35b.11f crc=0x6b0da69f
program = 0x0c0001 0x020000 byte16 vaj_41b.11h crc=0x6542c8a4

gfx = 0x000000 0x020000 byte64 va_09.4b crc=0x183dfaa8
