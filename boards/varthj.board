# --- what the battery held -----------------------------------------------
layer_control   = 0x20
priority        = 0x2e 0x2c 0x2a 0x28
palette_control = 0x30
layer_enable    = 0x20 0x04 0x02 0x00 0x00
id              = 0x32 0xffff
multiply        = 0x0e 0x0c 0x0a 0x08

bank_sizes = 0x4000 0x4000 0x0 0x0
gfx_bank = sprites|scroll1|scroll2|scroll3 0x00000 0x03fff 0
gfx_bank = sprites|scroll1|scroll2|scroll3 0x04000 0x07fff 1
