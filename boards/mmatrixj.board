# Board file for MAME's `mmatrixj`, written by tools/mame_to_board.zig.
#
# Transcribed from MAME's CPS-2 driver (BSD-3-Clause, Paul Leaman and
# the MAME team): src/mame/capcom/cps2.cpp for the ROM map, and
# cps1_v.cpp for the one row every CPS-2 board shares.
# A CPS-2 board has no battery-backed configuration to hold: it is the
# CPS-B-21 at its default strapping, and what its battery holds is the
# decryption key, which is `key` below.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
system = cps2

program = 0x000000 0x080000 word   mmxj.03 crc=0x1d5de213
program = 0x080000 0x080000 word   mmxj.04 crc=0xd943a339
program = 0x100000 0x080000 word   mmxj.05 crc=0x0c8b4abb

gfx = 0x000000 0x400000 word64 mmx.13m crc=0x04748718
gfx = 0x000002 0x400000 word64 mmx.15m crc=0x38074f44
gfx = 0x000004 0x400000 word64 mmx.17m crc=0xe4635e35
gfx = 0x000006 0x400000 word64 mmx.19m crc=0x4400a3f2
gfx = 0x1000000 0x400000 word64 mmx.14m crc=0xd52bf491
gfx = 0x1000002 0x400000 word64 mmx.16m crc=0x23f70780
gfx = 0x1000004 0x400000 word64 mmx.18m crc=0x2562c9d5
gfx = 0x1000006 0x400000 word64 mmx.20m crc=0x583a9687

audio = 0x000000 0x008000 byte   mmx.01 crc=0xc57e8171
audio = 0x010000 0x018000 byte   mmx.01 0x8000 crc=0xc57e8171

qsound = 0x000000 0x400000 word   mmx.11m crc=0x4180b39f
qsound = 0x400000 0x400000 word   mmx.12m crc=0x95e22a59

key = 0x000000 0x000014 byte   mmatrixj.key crc=0x3b50d889

# --- what a CPS-2 board is strapped to -----------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x02 0x04 0x08 0x30 0x30
id              = 0x32 0xffff
multiply        = 0x00 0x02 0x04 0x06

bank_sizes = 0x20000 0x20000 0x0 0x0
gfx_bank = scroll1|scroll2|scroll3 0x00000 0x1ffff 1
