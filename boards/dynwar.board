# Board file for MAME's `dynwar`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 30.11f crc=0xf9ec6d68
program = 0x000001 0x020000 byte16 35.11h crc=0xe41fff2f
program = 0x040000 0x020000 byte16 31.12f crc=0xe3de76ff
program = 0x040001 0x020000 byte16 36.12h crc=0x7a13cfbf
program = 0x080000 0x080000 word   tkm-9.8h crc=0x93654bcf

gfx = 0x000000 0x080000 word64 tkm-5.7a crc=0xf64bb6a0
gfx = 0x000002 0x080000 word64 tkm-8.9a crc=0x21fe6274
gfx = 0x000004 0x080000 word64 tkm-6.3a crc=0x0bf228cb
gfx = 0x000006 0x080000 word64 tkm-7.5a crc=0x1255dfb1
gfx = 0x200000 0x080000 word64 tkm-1.8a crc=0x44f7661e
gfx = 0x200002 0x080000 word64 tkm-4.10a crc=0xa54c515d
gfx = 0x200004 0x080000 word64 tkm-2.4a crc=0xca5c687c
gfx = 0x200006 0x080000 word64 tkm-3.6a crc=0xf9fe6591

audio = 0x000000 0x008000 byte   tke_17.12b crc=0xb3b79d4f
audio = 0x010000 0x008000 byte   tke_17.12b 0x8000 crc=0xb3b79d4f

oki = 0x000000 0x020000 byte   tke_18.11c crc=0xac6e307d
oki = 0x020000 0x020000 byte   tke_19.12c crc=0x068741db

# --- what the battery held -----------------------------------------------
layer_control   = 0x2c
priority        = 0x2a 0x28 0x26 0x24
palette_control = 0x22
layer_enable    = 0x02 0x04 0x08 0x00 0x00
id              = 0x20 0x0002

bank_sizes = 0x8000 0x8000 0x0 0x0
gfx_bank = sprites 0x00000 0x05fff 0
gfx_bank = scroll1 0x06000 0x07fff 0
gfx_bank = scroll2 0x04000 0x07fff 1
gfx_bank = scroll3 0x00000 0x03fff 1
