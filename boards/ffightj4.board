# Board file for MAME's `ffightj4`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up (DESIGN.md §8.1),
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 ff_36.12f crc=0xed988977
program = 0x000001 0x020000 byte16 ffj_42.12h crc=0x07bf1c21
program = 0x040000 0x020000 byte16 ff_37.13f crc=0xdba5a476
program = 0x040001 0x020000 byte16 ffj_43.13h crc=0xfbeca028
program = 0x080000 0x020000 byte16 ff_34.10f crc=0x0c8dc3fc
program = 0x080001 0x020000 byte16 ffj_40.10h crc=0x8075bab9
program = 0x0c0000 0x020000 byte16 ff_35.11f crc=0x4a934121
program = 0x0c0001 0x020000 byte16 ffj_41.11h crc=0x2af68154

gfx = 0x000000 0x020000 byte64 ff_09.4b crc=0x5b116d0d
gfx = 0x000001 0x020000 byte64 ff_01.4a crc=0x815b1797
gfx = 0x000002 0x020000 byte64 ff_13.9b crc=0x8721a7da
gfx = 0x000003 0x020000 byte64 ff_05.9a crc=0xd0fcd4b5
gfx = 0x000004 0x020000 byte64 ff_24.5e crc=0xa1ab607a
gfx = 0x000005 0x020000 byte64 ff_17.5c crc=0x2dc18cf4
gfx = 0x000006 0x020000 byte64 ffj_38.8h crc=0x6535a57f
gfx = 0x000007 0x020000 byte64 ff_32.8f crc=0xc8bc4a57
gfx = 0x100000 0x020000 byte64 ff_10.5b crc=0x624a924a
gfx = 0x100001 0x020000 byte64 ff_02.5a crc=0x5d91f694
gfx = 0x100002 0x020000 byte64 ff_14.10b crc=0x0a2e9101
gfx = 0x100003 0x020000 byte64 ff_06.10a crc=0x1c18f042
gfx = 0x100004 0x020000 byte64 ff_25.7e crc=0x6e8181ea
gfx = 0x100005 0x020000 byte64 ff_18.7c crc=0xb19ede59
gfx = 0x100006 0x020000 byte64 ffj_39.9h crc=0x9416b477
gfx = 0x100007 0x020000 byte64 ff_33.9f crc=0x7369fa07

# --- what the battery held -----------------------------------------------
layer_control   = 0x28
priority        = 0x2a 0x2c 0x2e 0x30
palette_control = 0x32
layer_enable    = 0x02 0x08 0x20 0x14 0x14
id              = 0x20 0x0005

bank_sizes = 0x4000 0x4000 0x0 0x0
gfx_bank = sprites 0x00000 0x03fff 0
gfx_bank = sprites 0x04000 0x043ff 1
gfx_bank = scroll1 0x04400 0x04bff 1
gfx_bank = scroll3 0x04c00 0x05fff 1
gfx_bank = scroll2 0x06000 0x07fff 1
