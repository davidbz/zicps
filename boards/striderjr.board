# Board file for MAME's `striderjr`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x080000 word   sthj_23.8f crc=0x046e7b12
program = 0x080000 0x080000 word   sthj_22.7f crc=0x9b3cfc08

gfx = 0x000000 0x080000 word64 sth_01.3a crc=0x4eee9aea
gfx = 0x000002 0x080000 word64 sth_02.4a crc=0x2d7f21e4
gfx = 0x000004 0x080000 word64 sth_03.5a crc=0x7705aa46
gfx = 0x000006 0x080000 word64 sth_04.6a crc=0x5b18b722
gfx = 0x200000 0x080000 word64 sth_05.7a crc=0x005f000b
gfx = 0x200002 0x080000 word64 sth_06.8a crc=0xb9441519
gfx = 0x200004 0x080000 word64 sth_07.9a crc=0xb7d04e8b
gfx = 0x200006 0x080000 word64 sth_08.10a crc=0x6b4713b4

audio = 0x000000 0x008000 byte   sth_09.12a crc=0x08d63519
audio = 0x010000 0x008000 byte   sth_09.12a 0x8000 crc=0x08d63519

oki = 0x000000 0x020000 byte   sth_18.11c crc=0x4386bc80
oki = 0x020000 0x020000 byte   sth_19.12c crc=0x444536d7

# --- what the battery held -----------------------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x02 0x04 0x08 0x30 0x30
id              = 0x32 0xffff
multiply        = 0x00 0x02 0x04 0x06

bank_sizes = 0x8000 0x8000 0x0 0x0
gfx_bank = stars 0x00000 0x003ff 0
gfx_bank = sprites 0x00000 0x04fff 0
gfx_bank = scroll2 0x04000 0x07fff 0
gfx_bank = scroll3 0x00000 0x07fff 1
gfx_bank = scroll1 0x07000 0x07fff 1
