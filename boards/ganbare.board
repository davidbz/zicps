# Board file for MAME's `ganbare`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x080000 word   mrnj_23d.8f crc=0xf929be72

gfx = 0x000000 0x080000 word64 mrnj_01.3a crc=0x3f878020
gfx = 0x000002 0x080000 word64 mrnj_02.4a crc=0x3e5624d8
gfx = 0x000004 0x080000 word64 mrnj_03.5a crc=0xd1e61f96
gfx = 0x000006 0x080000 word64 mrnj_04.6a crc=0xd241971b
gfx = 0x200000 0x080000 word64 mrnj_05.7a crc=0xc0a14562
gfx = 0x200002 0x080000 word64 mrnj_06.8a crc=0xe6a71dfc
gfx = 0x200004 0x080000 word64 mrnj_07.9a crc=0x99afb6c7
gfx = 0x200006 0x080000 word64 mrnj_08.10a crc=0x52882c20

# --- what the battery held -----------------------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x02 0x04 0x08 0x30 0x30
id              = 0x32 0xffff
multiply        = 0x00 0x02 0x04 0x06

bank_sizes = 0x8000 0x8000 0x0 0x0
gfx_bank = sprites 0x00000 0x03fff 0
gfx_bank = scroll1 0x04000 0x07fff 0
gfx_bank = scroll2 0x08000 0x0bfff 1
gfx_bank = scroll3 0x0c000 0x0ffff 1
