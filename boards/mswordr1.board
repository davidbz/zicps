# Board file for MAME's `mswordr1`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1

program = 0x000000 0x020000 byte16 ms_30.11f crc=0x21c1f078
program = 0x000001 0x020000 byte16 ms_35.11h crc=0xa540a73a
program = 0x040000 0x020000 byte16 ms_31.12f crc=0xd7e762b5
program = 0x040001 0x020000 byte16 ms_36.12h crc=0x66f2dcdb
program = 0x080000 0x080000 word   ms-32m.8h crc=0x2475ddfc

gfx = 0x000000 0x080000 word64 ms-5m.7a crc=0xc00fe7e2
gfx = 0x000002 0x080000 word64 ms-7m.9a crc=0x4ccacac5
gfx = 0x000004 0x080000 word64 ms-1m.3a crc=0x0d2bbe00
gfx = 0x000006 0x080000 word64 ms-3m.5a crc=0x3a1a5bf4

audio = 0x000000 0x008000 byte   ms_09.12b crc=0x57b29519
audio = 0x010000 0x008000 byte   ms_09.12b 0x8000 crc=0x57b29519

oki = 0x000000 0x020000 byte   ms_18.11c crc=0xfb64e90d
oki = 0x020000 0x020000 byte   ms_19.12c crc=0x74f892b9

# --- what the battery held -----------------------------------------------
layer_control   = 0x22
priority        = 0x24 0x26 0x28 0x2a
palette_control = 0x2c
layer_enable    = 0x20 0x02 0x04 0x00 0x00
id              = 0x2e 0x0403

bank_sizes = 0x8000 0x0 0x0 0x0
gfx_bank = sprites 0x00000 0x03fff 0
gfx_bank = scroll1 0x04000 0x04fff 0
gfx_bank = scroll2 0x05000 0x06fff 0
gfx_bank = scroll3 0x07000 0x07fff 0
