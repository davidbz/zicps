# Board file for MAME's `pmonster`, written by tools/mame_to_board.zig.
#
# The register mapping, the bank table and the Kabuki key are what a
# working board keeps in the RAM its battery holds up,
# transcribed from MAME's CPS-1 driver (BSD-3-Clause, Nicola Salmoria
# and the MAME team): src/mame/capcom/cps1.cpp and cps1_v.cpp.
#
# Untested: nobody here has this set to boot, so this file is only as
# right as the table it came from.
version = 1
cpu_clock = 10000000

program = 0x000000 0x080000 word   gbpj_23a.8f crc=0x52ef2d85

gfx = 0x000000 0x080000 word64 gbpj_01.3a crc=0xa7bea5bb
gfx = 0x000002 0x080000 word64 gbpj_02.4a crc=0x357b76ec
gfx = 0x000004 0x080000 word64 gbpj_03.5a crc=0xbcbc1881
gfx = 0x000006 0x080000 word64 gbpj_04.6a crc=0xb1126fde
gfx = 0x200000 0x080000 word64 gbpj_05.7a crc=0xbb5be4b0
gfx = 0x200002 0x080000 word64 gbpj_06.8a crc=0x1be8fd86
gfx = 0x200004 0x080000 word64 gbpj_07.9a crc=0xdeb8ef02
gfx = 0x200006 0x080000 word64 gbpj_08.10a crc=0x9f90359d

audio = 0x000000 0x008000 byte   gbpj_09.12a crc=0xfc431024
audio = 0x010000 0x008000 byte   gbpj_09.12a 0x8000 crc=0xfc431024

oki = 0x000000 0x020000 byte   gbpj_18.11c crc=0xcc54778d
oki = 0x020000 0x020000 byte   gbpj_19.12c crc=0xea8b56d8

# --- what the battery held -----------------------------------------------
layer_control   = 0x26
priority        = 0x28 0x2a 0x2c 0x2e
palette_control = 0x30
layer_enable    = 0x02 0x04 0x08 0x30 0x30
id              = 0x32 0xffff
multiply        = 0x00 0x02 0x04 0x06

bank_sizes = 0x8000 0x8000 0x0 0x0
gfx_bank = sprites 0x00000 0x03fff 0
gfx_bank = scroll1 0x04000 0x07fff 0
gfx_bank = scroll2 0x08000 0x0bfff 1
gfx_bank = scroll3 0x0c000 0x0ffff 1
